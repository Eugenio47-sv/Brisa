# Copia este archivo a .env en la raíz. Nunca lo subas a GitHub.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brisa
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Ejecuta npm run hash-password. Usa comillas simples al pegar el hash.
APP_PASSWORD_HASH=
# Opcionales: sin estas claves funcionan tus registros y cálculos locales.
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# URL exacta del frontend; en Render puedes omitirla si usas onrender.com.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Activa TLS verificado si el proveedor externo de PostgreSQL lo requiere.
DATABASE_SSL=false
